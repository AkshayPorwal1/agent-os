# AgentOS Backend Environment Variables
# Copy this file to .env and fill in your values.

# Gemini API Key — get one from https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your-api-key-here

# Google Cloud Project ID — required for Firestore
GCP_PROJECT_ID=your-project-id

# (Optional) Additional CORS origins for Cloud Run, comma-separated
# ALLOWED_ORIGINS=https://your-frontend.run.app
